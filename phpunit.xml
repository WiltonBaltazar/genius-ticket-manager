<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" on every entry below except DB_HOST/DB_PORT: docker-compose.yml's
             `env_file: .env` on the app service exports .env's values (APP_ENV=local,
             DB_DATABASE=genius_ticket_manager, CACHE_STORE=database, MAIL_MAILER=smtp, ...)
             as real container environment variables, and PHPUnit's <env> only sets a value
             that isn't already set — so without force="true", `docker compose exec app php
             artisan test` silently ran every test against the live dev database with real
             CSRF enforcement, real mail/queue/cache/session drivers, instead of this isolated
             config. DB_HOST/DB_PORT are deliberately left unforced: docker-compose.yml's own
             `environment: DB_HOST: mysql` correctly targets the mysql service from inside the
             container, whereas 127.0.0.1:3306 here is for running tests on the host directly. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- MySQL, not SQLite: this schema relies on generated columns, JSON columns, and
             InnoDB row-locking semantics that SQLite doesn't equivalently support (tasks.md T003). -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="genius_ticket_manager_test" force="true"/>
        <env name="DB_USERNAME" value="genius" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
